# Copy this file to .env and fill in values you want to override.
# .env is gitignored — never commit your real API keys.

# Required. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Anthropic model ID used by all three agents (Designer, Generator, Critic).
# Use claude-sonnet-5-5 for cheaper / faster runs.
ANTHROPIC_MODEL=claude-opus-5-5
