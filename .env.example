# Copy this file to .env and fill in values you want to override.
# .env is gitignored — never commit your real API keys.

# Which backend to use: "ollama" (local, free) or "anthropic" (cloud, pay-per-use)
LLM_PROVIDER=ollama

# Ollama model tag (only used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5-coder:7b

# Anthropic model ID (only used when LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-opus-4-8

# Required when LLM_PROVIDER=anthropic. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
